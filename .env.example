API_BASE_URL=https://api.example.com
GEOAPIFY_API_KEY=your-geoapify-key

# Auth0
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_AUDIENCE=
AUTH0_CONNECTION=Username-Password-Authentication

# Use in-app payment for ticket checkout (backend must implement the checkout payment endpoint)
USE_IN_APP_PAYMENT=false

# Optional: base URL for MinIO/object storage so images load on emulators (e.g. Android use http://10.0.2.2:9000 when backend returns http://localhost:9000)
# ASSET_BASE_URL=

# DB connection (used by seed reset scripts)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shade_dev
DB_USERNAME=postgres
DB_PASSWORD=

# Seed (creates 3 users in Auth0 if missing; then seeds DB via API)
# For Auth0 Database connection, disable "Require Email Verification" in dev so seed can sign in after signup.
# For full reset (npm run seed:data): path to sade-mono backend (uses scripts/Reset_Clean_Up_DB.sh + make compose-up)
# Example: /Users/mayokun/Desktop/SHDE/sade-mono
SEED_BACKEND_DIR=
SEED_COMPOSE_DOWN_CMD=make compose-down
SEED_COMPOSE_UP_CMD=make compose-up ENV_FILE=.env
SEED_USER1_EMAIL=mayowa.akinwale@capsuleapp.dev
SEED_USER1_PASSWORD=SeedPass123!
SEED_USER2_EMAIL=adaeze.okonkwo@capsuleapp.dev
SEED_USER2_PASSWORD=SeedPass123!
SEED_USER3_EMAIL=chinedu.eze@capsuleapp.dev
SEED_USER3_PASSWORD=SeedPass123!
