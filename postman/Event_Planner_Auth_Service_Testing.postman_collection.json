		{
			"name": "🛡️ Security Testing",
			"item": [
				{
					"name": "Test X-Internal-Auth Header",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-Internal-Auth",
								"value": "dev-internal-gateway"
							}
						],
						"url": {
							"raw": "http://localhost:8090/api/v1/auth/health",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8090",
							"path": [
								"api",
								"v1",
								"auth",
								"health"
							]
						},
						"description": "Test direct access to Auth Service with the correct X-Internal-Auth header. This should work and demonstrate the internal security mechanism."
					},
					"response": []
				},
				{
					"name": "Test Wrong X-Internal-Auth Header",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-Internal-Auth",
								"value": "wrong-secret"
							}
						],
						"url": {
							"raw": "http://localhost:8090/api/v1/auth/health",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8090",
							"path": [
								"api",
								"v1",
								"auth",
								"health"
							]
						},
						"description": "Test direct access with wrong X-Internal-Auth header - should return 403 Forbidden."
					},
					"response": []
				},
				{
					"name": "Test SQL Injection Protection",
					"request": {
						"method": "POST",
						"header": [
