								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"'; DROP TABLE users; --\",\n    \"password\": \"TestPass123@\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Test SQL injection protection by attempting malicious input."
					},
					"response": []
				}
			],
			"description": "Security testing to verify the X-Internal-Auth mechanism and other security measures."
		},
