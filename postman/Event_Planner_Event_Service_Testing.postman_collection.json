		{
			"name": "📅 Event Management Testing",
			"item": [
				{
					"name": "Create Event (via Gateway)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response has event data\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('id');",
									"    pm.expect(jsonData).to.have.property('name');",
									"    pm.expect(jsonData).to.have.property('date');",
									"});",
									"",
									"// Store event ID for later use",
									"if (pm.response.code === 201) {",
									"    const jsonData = pm.response.json();",
									"    pm.environment.set('event_id', jsonData.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"{{test_event_name}}\",\n    \"type\": \"{{test_event_type}}\",\n    \"date\": \"{{test_event_date}}\",\n    \"organizationId\": \"{{user_id}}\",\n    \"venueId\": null,\n    \"metadata\": {\n        \"description\": \"A test event for Postman testing\",\n        \"maxAttendees\": 100,\n        \"budget\": 50000\n    }\n}"
