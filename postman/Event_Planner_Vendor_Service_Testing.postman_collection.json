	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Set default base URL if not already set",
					"if (!pm.environment.get('base_url')) {",
					"    pm.environment.set('base_url', 'http://localhost:8080');",
					"}",
					"",
					"// Set default token type if not already set",
					"if (!pm.environment.get('token_type')) {",
					"    pm.environment.set('token_type', 'Bearer');",
					"}",
					"",
					"// Generate unique test data for each run",
					"const timestamp = Date.now();",
					"const randomId = Math.floor(Math.random() * 10000);",
					"",
					"// Generate unique test user data",
					"pm.environment.set('test_email', `testuser_${timestamp}_${randomId}@example.com`);",
					"pm.environment.set('test_name', `Test User ${timestamp}`);",
					"pm.environment.set('test_phone', `+123456789${randomId}`);",
					"pm.environment.set('test_password', 'TestPassword123!');",
					"pm.environment.set('test_device_id', `device_${timestamp}_${randomId}`);",
					"pm.environment.set('test_client_id', `client_${timestamp}_${randomId}`);",
					"",
					"// Generate unique vendor test data",
					"pm.environment.set('test_vendor_name', `Test Vendor ${timestamp}`);",
					"pm.environment.set('test_vendor_description', `Test vendor description for ${timestamp}`);",
					"pm.environment.set('test_vendor_email', `vendor_${timestamp}_${randomId}@example.com`);",
					"pm.environment.set('test_vendor_phone', `+1-555-${randomId}`);",
					"pm.environment.set('test_vendor_address', `${randomId} Test Street, Test City, TC 12345`);",
					"",
					"// Auto-authentication setup for Vendor Service requests",
					"// Only set Authorization header for Vendor Service API requests",
					"const requestUrl = pm.request.url.toString();",
					"if (requestUrl.includes('/api/v1/vendors')) {",
					"    // Check if we already have a valid auth token",
					"    if (!pm.environment.get('auth_token')) {",
					"        // Try to register a new user first",
					"        const registerRequest = {",
					"            url: pm.environment.get('base_url') + '/api/v1/auth/register',",
					"            method: 'POST',",
					"            header: {",
					"                'Content-Type': 'application/json'",
					"            },",
					"            body: {",
					"                mode: 'raw',",
					"                raw: JSON.stringify({",
					"                    email: pm.environment.get('test_email'),",
					"                    name: pm.environment.get('test_name'),",
					"                    phone: pm.environment.get('test_phone'),",
					"                    password: pm.environment.get('test_password'),",
					"                    deviceId: pm.environment.get('test_device_id'),",
					"                    clientId: pm.environment.get('test_client_id')",
					"                })",
					"            }",
					"        };",
					"",
					"        pm.sendRequest(registerRequest, function (err, response) {",
					"            if (err) {",
					"                console.log('Register request failed:', err);",
					"                // If registration fails, try to login with existing user",
					"                const loginRequest = {",
					"                    url: pm.environment.get('base_url') + '/api/v1/auth/login',",
					"                    method: 'POST',",
					"                    header: {",
					"                        'Content-Type': 'application/json'",
					"                    },",
					"                    body: {",
					"                        mode: 'raw',",
					"                        raw: JSON.stringify({",
					"                            email: pm.environment.get('test_email'),",
					"                            password: pm.environment.get('test_password'),",
					"                            deviceId: pm.environment.get('test_device_id'),",
					"                            clientId: pm.environment.get('test_client_id')",
					"                        })",
					"                    }",
					"                };",
					"",
					"                pm.sendRequest(loginRequest, function (err, response) {",
					"                    if (response && response.json()) {",
					"                        const jsonData = response.json();",
					"                        pm.environment.set('auth_token', jsonData.accessToken);",
					"                        pm.environment.set('refresh_token', jsonData.refreshToken);",
					"                        pm.environment.set('token_type', jsonData.tokenType || 'Bearer');",
					"                        pm.environment.set('user_id', jsonData.userId);",
					"                        console.log('Login successful, token set');",
					"                    }",
					"                });",
					"            } else if (response && response.json()) {",
					"                const jsonData = response.json();",
					"                pm.environment.set('auth_token', jsonData.accessToken);",
					"                pm.environment.set('refresh_token', jsonData.refreshToken);",
					"                pm.environment.set('token_type', jsonData.tokenType || 'Bearer');",
					"                pm.environment.set('user_id', jsonData.userId);",
					"                console.log('Registration successful, token set');",
					"            }",
					"        });",
					"    }",
					"    ",
					"    // Set Authorization header for the current request",
					"    if (pm.environment.get('auth_token')) {",
					"        pm.request.headers.add({",
					"            key: 'Authorization',",
					"            value: pm.environment.get('token_type') + ' ' + pm.environment.get('auth_token')",
					"        });",
					"    }",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global test to log response details",
					"console.log('Response Status:', pm.response.code);",
					"console.log('Response Time:', pm.response.responseTime + 'ms');",
					"",
					"// Log response body for debugging (first 500 chars)",
					"if (pm.response.text()) {",
					"    console.log('Response Body:', pm.response.text().substring(0, 500));",
					"}"
				]
			}
		}
