	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Set default base URL if not already set",
					"if (!pm.environment.get('base_url')) {",
					"    pm.environment.set('base_url', 'http://localhost:8080');",
					"}",
					"",
					"// Set default token type if not already set",
					"if (!pm.environment.get('token_type')) {",
					"    pm.environment.set('token_type', 'Bearer');",
					"}",
					"",
					"// Generate unique test data for each run",
					"const timestamp = Date.now();",
					"const randomId = Math.floor(Math.random() * 10000);",
					"",
					"// Set unique test user data",
					"pm.environment.set('test_email', `paymentstest${timestamp}@example.com`);",
					"pm.environment.set('test_name', `Payments Test User ${randomId}`);",
					"pm.environment.set('test_phone', `+1234567${randomId.toString().padStart(4, '0')}`);",
					"pm.environment.set('test_password', 'TestPass123@');",
					"",
					"// Set test device info",
					"pm.environment.set('test_device_id', `payments-test-device-${timestamp}`);",
					"pm.environment.set('test_client_id', 'postman-payments-test');",
					"",
					"// Set test payment data",
					"pm.environment.set('test_payment_amount', (Math.random() * 1000 + 10).toFixed(2));",
					"pm.environment.set('test_payment_currency', 'USD');",
					"pm.environment.set('test_payment_method', 'credit_card');",
					"pm.environment.set('test_card_number', '4111111111111111');",
					"pm.environment.set('test_card_cvv', '123');",
					"pm.environment.set('test_card_expiry', '12/25');",
					"",
					"console.log('Pre-request: Test data generated for Payments Service run', timestamp);",
					"",
					"// Auto-authentication for Payments Service endpoints",
					"if (pm.info.requestName.includes('Payment') && !pm.info.requestName.includes('Auth') && !pm.info.requestName.includes('Health') && !pm.info.requestName.includes('Swagger') && !pm.info.requestName.includes('OpenAPI') && !pm.info.requestName.includes('Direct') && !pm.info.requestName.includes('X-Internal-Auth')) {",
					"    ",
					"    // Check if we already have a valid token",
					"    if (!pm.environment.get('auth_token') || pm.environment.get('auth_token') === '') {",
					"        console.log('No auth token found, attempting to login...');",
					"        ",
					"        // First try to register a user",
					"        const registerRequest = {",
					"            url: pm.environment.get('base_url') + '/api/v1/auth/register',",
					"            method: 'POST',",
					"            header: {",
					"                'Content-Type': 'application/json'",
					"            },",
					"            body: {",
					"                mode: 'raw',",
					"                raw: JSON.stringify({",
					"                    email: pm.environment.get('test_email'),",
					"                    name: pm.environment.get('test_name'),",
					"                    password: pm.environment.get('test_password'),",
					"                    confirmPassword: pm.environment.get('test_password'),",
					"                    phoneNumber: pm.environment.get('test_phone'),",
					"                    acceptTerms: true,",
					"                    acceptPrivacy: true,",
					"                    marketingOptIn: false",
					"                })",
					"            }",
					"        };",
					"        ",
					"        try {",
					"            const registerResponse = pm.sendRequest(registerRequest);",
					"            if (registerResponse.code === 201) {",
					"                const registerData = registerResponse.json();",
					"                pm.environment.set('auth_token', registerData.accessToken);",
					"                pm.environment.set('refresh_token', registerData.refreshToken);",
					"                pm.environment.set('token_type', 'Bearer');",
					"                pm.environment.set('user_id', registerData.user.id);",
					"                console.log('User registered and token set');",
					"            }",
					"        } catch (e) {",
					"            console.log('Registration failed, trying login...');",
					"        }",
					"        ",
					"        // If registration failed or token still not set, try login",
					"        if (!pm.environment.get('auth_token') || pm.environment.get('auth_token') === '') {",
					"            const loginRequest = {",
					"                url: pm.environment.get('base_url') + '/api/v1/auth/login',",
					"                method: 'POST',",
					"                header: {",
					"                    'Content-Type': 'application/json'",
					"                },",
					"                body: {",
					"                    mode: 'raw',",
					"                    raw: JSON.stringify({",
					"                        email: pm.environment.get('test_email'),",
					"                        password: pm.environment.get('test_password'),",
					"                        rememberMe: false,",
					"                        deviceId: pm.environment.get('test_device_id'),",
					"                        clientId: pm.environment.get('test_client_id'),",
					"                    })",
					"                }",
					"            };",
					"            ",
					"            try {",
					"                const loginResponse = pm.sendRequest(loginRequest);",
					"                if (loginResponse.code === 200) {",
					"                    const loginData = loginResponse.json();",
					"                    pm.environment.set('auth_token', loginData.accessToken);",
					"                    pm.environment.set('refresh_token', loginData.refreshToken);",
					"                    pm.environment.set('token_type', 'Bearer');",
					"                    pm.environment.set('user_id', loginData.user.id);",
					"                    console.log('User logged in and token set');",
					"                }",
					"            } catch (e) {",
					"                console.log('Login failed:', e);",
					"            }",
					"        }",
					"    }",
					"    ",
					"    // Set Authorization header for Payments Service requests",
					"    if (pm.environment.get('auth_token') && pm.environment.get('auth_token') !== '') {",
					"        pm.request.headers.add({",
					"            key: 'Authorization',",
					"            value: pm.environment.get('token_type') + ' ' + pm.environment.get('auth_token')",
					"        });",
					"        console.log('Authorization header set for Payments Service request');",
					"    }",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global test to log response details",
					"console.log('Response Status:', pm.response.code);",
					"console.log('Response Time:', pm.response.responseTime + 'ms');",
					"",
					"// Log response body for debugging (first 500 chars)",
					"if (pm.response.text()) {",
					"    console.log('Response Body:', pm.response.text().substring(0, 500));",
					"}"
				]
			}
		}
	],
