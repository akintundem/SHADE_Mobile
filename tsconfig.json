{
  "compilerOptions": {
    "target": "ES2015",
    "lib": ["ES2015"],
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-native",
    "noEmit": true,
    "isolatedModules": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["**/*.ts", "**/*.tsx", "nativewind-env.d.ts"],
  "exclude": ["**/node_modules", "**/Pods", "test"]
}
